
# never commit real credentials
.env
adjudication/.env
adjudication/profiles.json

# Run artifacts: audit logs are the operator's tamper-evident records of a
# specific run, not repository content, and may quote the adjudicated artifact.
adjudication/run-*.jsonl
adjudication/run-*.jsonl.head

# Run folders are the operator working set: artifacts, candidates, audit logs.
# Not repository content.
adjudication/runs/

# Operator-approved command list and canary questions are local policy,
# not repository content.
adjudication/approved-commands.json
adjudication/canaries.json
