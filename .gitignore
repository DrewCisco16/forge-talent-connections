# and design_tokens.json / figma_node_map.md carry the Figma file key and URL.
design_handoff/

# The web demo build is committed so Cloudflare Pages can serve it, but the
# CanvasKit renderer is not: this build fetches it from Google's CDN, so the
# locally emitted copy is 37MB of dead weight.
demo/canvaskit/
test/goldens/failures/
