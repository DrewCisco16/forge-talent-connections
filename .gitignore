# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml

# Secrets and config: never commit. Config is supplied via --dart-define.
.env
.env.*
*.env
env/
config/secrets*.json

# OS / editor
.DS_Store
.idea/
.vscode/

# Design handoff package: kept local as build input, never committed.
# SCREENS_SPEC.md contains engine names barred from this repo by the build rules,
# and design_tokens.json / figma_node_map.md carry the Figma file key and URL.
design_handoff/

# The web demo build is committed so Cloudflare Pages can serve it, but the
# CanvasKit renderer is not: this build fetches it from Google's CDN, so the
# locally emitted copy is 37MB of dead weight.
demo/canvaskit/
test/goldens/failures/

# never commit real credentials
adjudication/.env
adjudication/profiles.json

# Run artifacts: audit logs are the operator's tamper-evident records of a
# specific run, not repository content, and may quote the adjudicated artifact.
adjudication/run-*.jsonl
adjudication/run-*.jsonl.head

# Run folders are the operator working set: artifacts, candidates, audit logs.
# Not repository content.
adjudication/runs/

# The Full Council decision log (adjudication/decision_log.py) is the
# operator's own record and can quote sensitive material, so it stays out of
# the repository by default, like run audit logs. Keeping it is a deliberate
# operator choice: copy it out, or commit it as GREEN-only material.
adjudication/decisions/

# Operator-approved command list and canary questions are local policy,
# not repository content.
adjudication/approved-commands.json
adjudication/canaries.json

# Accumulated daily spend is per-machine runtime state the runner rewrites on
# every run, not repository content. Tracking it dirtied the tree on each run
# and pushed the operator's real spend figures; worse, a merge of two machines'
# copies could resolve the day's total DOWNWARD, which silently raises the
# effective ceiling. A missing file already reads as zero spent.
adjudication/.spend-by-day.json
