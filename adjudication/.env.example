# Copy to .env and fill in. NEVER commit .env -- it is in .gitignore.
#
# Four external seats plus Claude in-process, per PANEL_OF_FIVE.
# load_panel() FAILS CLOSED on a missing or blank credential: a panel that
# quietly runs short misstates rho, effective seats, and the residual.

ADJ_SEAT_1_API_KEY=
ADJ_SEAT_1_MODEL=

ADJ_SEAT_2_API_KEY=
ADJ_SEAT_2_MODEL=

ADJ_SEAT_3_API_KEY=
ADJ_SEAT_3_MODEL=

ADJ_SEAT_4_API_KEY=
ADJ_SEAT_4_MODEL=

# Seat 5 runs in-process and takes no key. It still needs a model id.
# It MUST be a separate session from the one running the orchestrator --
# a seat that can see gate verdicts is not blind, and its errors correlate
# with the adjudication itself.
ADJ_SEAT_5_MODEL=
