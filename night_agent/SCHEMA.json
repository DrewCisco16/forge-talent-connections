  "operators": {
    "EXPERIMENT": {
      "precondition": "class in (HYBRID, EXPERIMENT) and executor registered and >=2 options differ on a MEASURABLE PREDICTION",
      "kills": "options whose predictions fail when executed"
    },
    "FMEA": {
      "description": "FMEA, FTA, FMEDA. What goes wrong later, and would we notice in time?",
      "precondition": "options_standing >= 1",
      "kills": "failures that are real but invisible"
    },
    "IDOV": {
      "description": "IDOV. Can this be built, measured, tested?",
      "precondition": "kind in (build, solve, strategy)",
      "kills": "answers that survive on paper only"
    },
    "BAYES": {
      "description": "Bayesian, MCMC. What evidence would move us and how much?",
      "precondition": "options_standing >= 2 or open has item without settle condition",
      "kills": "answers needing a number nobody can derive"
    },
    "TRIZ": {
      "description": "CST, TRIZ, Zero Defects. Knock-on effects and the contradiction at the centre.",
      "precondition": "options_standing >= 2",
      "kills": "answers that split the difference"
    }
  },
