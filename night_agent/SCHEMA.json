  "merged_line_format": "<claim text> [<prov>]... {C<id>,...}   every cited id must be PASSED in a check file of this or an earlier stage",
  "transition_guards": {
    "tool": "TESTS/na_gate.py",
    "G-1": "GATE: ask.md present; READY generators >= min_crew; READY closer",
    "G-2": "GENERATE/BASELINE/DIRECT: gate.json with CLASS, and CLASS enters that state (DIRECT -> DIRECT; DELIBERATION, HYBRID, HYBRID-NO-EXEC -> GENERATE; EXPERIMENT, HYBRID -> BASELINE)",
    "G-3": "CHECK: >= min_crew seat files whose stamp names this stage and a READY registered seat and whose capture record says completion_signal_observed and not partial; a DIRECT stage needs one",
    "G-4": "CLOSE: check.md present, six statuses only, RETRIEVED on PASSED/FAILED, METHOD not none on PASSED/FAILED, support=SUPPORTED grade=A on a PASSED source or document claim, SETTLE on the other four",
    "G-5": "OPERATE: previous close.md, no stop reason, operator not already run, operator in the library, operator stages below max_operators",
    "G-6": "REVIEW: last close.md, reviewer handshake exactly once, no reviewer sends after it",
    "G-7": "FINAL: DELIVERABLE.md absent, kills-all.md and metrics-summary.json present, review checked or NO_OUTSIDE_REVIEW",
    "G-8": "VERIFY: DELIVERABLE.md present, verifier.md absent",
    "G-9": "DECIDE=KEEP: repeat_value present, delta beyond noise or MIN_DELTA, guardrails within tolerance, constraints checked",
    "G-10": "MERGED lines: provenance tag and PASSED claim ids (post hoc, na_check.py)",
    "G-11": "SEND: unique dispatch_id, observed conversation_url equals registry URL, previous slot for the seat not uncertain, reservation covers the tail; a reply citing an earlier stage's dispatch_id is stale"
  },
