{
  "_comment": "Claude Code permissions for the overnight loop. Scoped allowlist, no blanket bypass: the agent can run the scorer, the test tools, and read-only git, and edit only inside adjudication/. Anything not listed is denied in non-interactive mode, which is the point. The scorer's scope gate is the backstop if a path slips through.",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(./adjudication/*.py)",
      "Write(./adjudication/*.py)",
      "MultiEdit(./adjudication/*.py)",
      "Edit(./autoresearch/NIGHT-SUMMARY.md)",
      "Write(./autoresearch/NIGHT-SUMMARY.md)",
      "Bash(python autoresearch/score.py:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m ruff:*)",
      "Bash(python -m mypy:*)",
      "Bash(python -m bandit:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(sed -n:*)"
    ],
    "deny": [
      "Read(./adjudication/.env)",
      "Read(./adjudication/profiles.json)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./program.md)",
      "Edit(./autoresearch/score.py)",
      "Edit(./autoresearch/results.tsv)",
      "Edit(./autoresearch/settings.json)",
      "Edit(./adjudication/pyproject.toml)",
      "Edit(./adjudication/requirements.txt)",
      "Edit(./adjudication/requirements-dev.txt)",
      "Edit(./.github/**)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git rebase:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git clean:*)",
      "Bash(rm:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(pip install:*)",
      "Bash(python -m pip:*)",
      "Bash(uv:*)",
      "Bash(sudo:*)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
